[configuration]

entry_symbol = "arcapture_library_init"
compatibility_minimum = "4.6"

[libraries]

windows.debug.x86_64 = "res://bin/libarcapture.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libarcapture.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://bin/libarcapture.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libarcapture.android.template_release.arm64.so"
