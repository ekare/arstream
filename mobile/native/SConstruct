#!/usr/bin/env python
# arcapture GDExtension build script.
# Builds against Godot 4.6.x (mobile/thirdparty/godot-cpp/gdextension/extension_api-4-6.json).

env = SConscript("../thirdparty/godot-cpp/SConstruct", {"api_version": "4.6"})

if env["platform"] == "android":
    # godot-cpp's tools/android.py builds the static lib with every one of
    # its hundreds of generated class .o files listed directly on the ar
    # command line. tools/web.py already works around the equivalent issue
    # for emar via TempFileMunge -- android.py doesn't, and Linux's ARG_MAX
    # is low enough to overflow on this ("Argument list too long", confirmed
    # on GitHub Actions ubuntu-latest; not hit on Windows, which is why this
    # wasn't caught locally). llvm-ar (NDK toolchain) supports the same
    # @responsefile syntax emar does, so the identical fix applies.
    env["ARCOM_POSIX"] = env["ARCOM"].replace("$TARGET", "$TARGET.posix").replace("$SOURCES", "$SOURCES.posix")
    env["ARCOM"] = "${TEMPFILE(ARCOM_POSIX)}"

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
sources += Glob("src/sink/*.cpp")
sources += Glob("src/net/*.cpp")

# Platform-specific sources are only added to the build when that platform is targeted.
if env["platform"] == "android":
    sources += Glob("src/capture/android/*.cpp")
    sources += Glob("src/encode/*android*.cpp")
    sources += Glob("src/sensors/android/*.cpp")
    sources += Glob("src/platform/android/*.cpp")
    # NDK Camera2 + Media (AMediaCodec) + Sensor -- pure C APIs. The lone
    # exception is platform/android/android_context.cpp, the single JNI
    # bootstrap entry point (see mobile/android/plugins/jni_bootstrap/) --
    # no extra LIBS needed, JNI symbols resolve through the JavaVM*/JNIEnv*
    # function pointers handed in at runtime, not link-time.
    env.Append(LIBS=["camera2ndk", "mediandk", "android"])
    # ARCore's C API (arcore_c_api.h + libarcore_sdk_c.so) is not part of
    # the NDK -- vendored via mobile/thirdparty/fetch_arcore_sdk.ps1, see
    # that script's header comment for why it isn't committed to git.
    env.Append(CPPPATH=["../thirdparty/arcore/include"])
    env.Append(LIBPATH=["../thirdparty/arcore/jni/arm64-v8a"])
    env.Append(LIBS=["arcore_sdk_c"])
    # EGL/GLESv2 -- gl_blit_renderer.cpp draws ARCore's
    # GL_TEXTURE_EXTERNAL_OES camera texture into the encoder's Surface
    # (ARCore has no zero-copy Surface-write path the way Camera2 does).
    env.Append(LIBS=["EGL", "GLESv2"])
elif env["platform"] == "ios":
    sources += Glob("src/capture/ios/*.mm")
    sources += Glob("src/encode/*ios*.cpp")

library = env.SharedLibrary(
    "../bin/libarcapture{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

env.NoCache(library)
Default(library)
