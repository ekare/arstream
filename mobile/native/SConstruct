#!/usr/bin/env python
# arcapture GDExtension build script.
# Godot 4.6.x'e karsi derlenir (mobile/thirdparty/godot-cpp/gdextension/extension_api-4-6.json).

env = SConscript("../thirdparty/godot-cpp/SConstruct", {"api_version": "4.6"})

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
sources += Glob("src/sink/*.cpp")

# Platforma-ozel kaynaklar yalnizca ilgili platform hedeflenirken derlemeye dahil edilir.
if env["platform"] == "android":
    sources += Glob("src/capture/android/*.cpp")
    sources += Glob("src/encode/*android*.cpp")
    # NDK Camera2 + Media (AMediaCodec) -- saf C API'ler, Kotlin/JNI gerekmez.
    env.Append(LIBS=["camera2ndk", "mediandk", "android"])
elif env["platform"] == "ios":
    sources += Glob("src/capture/ios/*.mm")
    sources += Glob("src/encode/*ios*.cpp")

library = env.SharedLibrary(
    "../bin/libarcapture{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

env.NoCache(library)
Default(library)
