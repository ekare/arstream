#!/usr/bin/env python
# Standalone host-build script for protocol_test -- has NO dependency on
# godot-cpp, runs in CI without a device/emulator/Android SDK (see docs/ROADMAP.md M7).
#
# Run: cd mobile/native/tests && scons

env = Environment()
if env["PLATFORM"] == "win32":
	env.Append(CXXFLAGS=["/std:c++17", "/EHsc"])
else:
	env.Append(CXXFLAGS=["-std=c++17"])

env.Program("protocol_test", ["protocol_test.cpp", "../src/net/protocol.cpp"])
