# --- Godot ---
mobile/.godot/
mobile/export_presets.cfg
*.import

# --- GDExtension / SCons / C++ build ---
mobile/native/.sconsign.dblite
mobile/native/build/
mobile/bin/
**/*.os
**/*.obj
**/*.o
compile_commands.json

# --- Host-native protocol test (mobile/native/tests/) ---
mobile/native/tests/.sconsign.dblite
mobile/native/tests/protocol_test
mobile/native/tests/protocol_test.exe
mobile/native/tests/protocol_test.exp
mobile/native/tests/protocol_test.lib
mobile/native/tests/protocol_test.pdb

# --- Android NDK / Gradle leftovers ---
# Godot's own installed Gradle Android build template (Project > Install
# Android Build Template...) -- regenerable, not hand-edited. .build_version
# is a small sibling marker the same editor action writes (just the Godot
# version string) -- ignored alongside build/ since a marker with no
# matching template content would be meaningless clutter.
mobile/android/build/
mobile/android/.build_version
# The jni_bootstrap plugin's own Gradle module build output (its *source*
# -- build.gradle.kts, src/, gradlew -- IS committed; only output is not).
# Its built .aar IS committed too, under mobile/addons/jni_bootstrap/bin/,
# since Godot's export step expects it pre-built and does not run Gradle
# for it itself.
mobile/android/plugins/*/build/
mobile/android/plugins/*/.gradle/
mobile/android/plugins/*/local.properties
.gradle/
local.properties
*.apk
*.aab

# --- ARCore SDK (vendored via mobile/thirdparty/fetch_arcore_sdk.ps1) ---
# Carries Google's own ARCore Additional Terms of Service, not this
# project's license -- never committed, fetched fresh per clone/CI run.
mobile/thirdparty/arcore/
mobile/android/plugins/jni_bootstrap/src/main/jniLibs/

# --- iOS / Xcode (future) ---
*.xcodeproj/
*.xcworkspace/
DerivedData/

# --- godot-cpp submodule build artifacts ---
mobile/thirdparty/godot-cpp/bin/
mobile/thirdparty/godot-cpp/gen/

# --- Python ---
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Captured test data / outputs ---
server/captures/
*.log
*.pid

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
